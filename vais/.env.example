# Nur für lokalen Betrieb: Kopiere diese Datei zu ".env".
# Online (Render) werden dieselben Werte als Umgebungsvariablen eingetragen.

PORT=3000

# Auf "true" setzen, sobald die Seite über https läuft (sichere Cookies)
COOKIE_SECURE=false

# ── KI-Modelle (OpenRouter) ───────────────────────────────────────
# Kostenloser Schlüssel von openrouter.ai/keys. Leer lassen = Demo-Modus.
OPENROUTER_API_KEY=
# Google Gemini/Gemma kostenlos: aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq kostenlos (gpt-oss, Llama, Qwen, Kimi, Websuche): console.groq.com/keys
GROQ_API_KEY=
# Optional, kostet Guthaben: zusätzliche OpenRouter-Modelle, durch Komma getrennt
OPENROUTER_EXTRA_MODELS=

# ── Datenbank (Turso) ─────────────────────────────────────────────
# Leer lassen = lokale Datei data/vais.db
DATABASE_URL=
DATABASE_TOKEN=

# ── E-Mail-Versand ────────────────────────────────────────────────
# Einfachster Weg: Brevo-API-Schlüssel (beginnt mit xkeysib-). Dann wird SMTP nicht gebraucht.
BREVO_API_KEY=

# Alternativ SMTP (z. B. Brevo):
# Leer lassen = Entwicklungsmodus: Der Code erscheint nur in der Konsole.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VAIs <deine-adresse@gmail.com>"
