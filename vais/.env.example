# Kopiere diese Datei zu ".env" und trage deine Werte ein.

# Port des Servers
PORT=3000

# Öffentliche Adresse der Seite (wird in E-Mails verwendet)
APP_URL=http://localhost:3000

# Auf "true" setzen, sobald die Seite über https läuft (sichere Cookies)
COOKIE_SECURE=false

# ── E-Mail-Versand (SMTP) ─────────────────────────────────────────
# Ohne diese Werte läuft VAIs im Entwicklungsmodus: Der Bestätigungscode
# wird dann nur in der Server-Konsole ausgegeben statt per E-Mail verschickt.
#
# Beispiel Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=deine@gmail.com, SMTP_PASS=<App-Passwort, nicht dein normales Passwort>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VAIs <no-reply@example.com>"
