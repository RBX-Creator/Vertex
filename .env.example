# Pflicht: Token von @BotFather (niemals teilen oder committen!)
TELEGRAM_BOT_TOKEN=

# Deine Telegram-User-ID(s) für Admin-Befehle, mit Komma getrennt (z. B. von @userinfobot)
ADMIN_IDS=

# Optional: Postgres (z. B. Neon/Supabase). Wenn leer -> SQLite-Datei
DATABASE_URL=
SQLITE_PATH=./data/bot.sqlite

# Optional: Webhook-Modus (z. B. auf Render). Wenn leer -> Long Polling
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=3000

# Optional: Limits
LIKES_PER_DAY=50
MSGS_PER_MINUTE=20
VIEW_COOLDOWN_HOURS=24
BOT_NAME=VERTEX Partner
