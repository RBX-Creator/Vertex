# Kopieren nach config/.env und ausfüllen. config/.env wird NIE committet.

# --- Gehirn (Pflicht für echten Betrieb; ohne Schlüssel läuft der Demo-Modus) ---
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-opus-5-5
JARVIS_EFFORT=low            # low = schnelle Antworten; medium/high = gründlicher, langsamer, teurer
JARVIS_TZ=Europe/Berlin

# --- Server ---
PORT=3000
JARVIS_TEAM_CODE=            # Wer ein Profil anlegen will, braucht diesen Code. Leer = jeder darf (nur lokal!)
JARVIS_SECRET=               # optional; sonst wird automatisch eins in data/.secret erzeugt
JARVIS_DATA_DIR=             # optional; Standard: jarvis/data
# JARVIS_DEMO=1              # Demo-Modus erzwingen

# --- Stimme (Phase 3) ---
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Hand (Phase 4) ---
HAND_AGENT_TOKEN=
