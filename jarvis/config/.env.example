# Kopieren nach config/.env und ausfüllen. config/.env wird NIE committet.

# Gehirn / Kern
ANTHROPIC_API_KEY=
JARVIS_TZ=Europe/Berlin
JARVIS_AUTH_TOKEN=          # schützt den Server, wenn er öffentlich erreichbar ist

# Stimme (Phase 3)
DEEPGRAM_API_KEY=           # Speech-to-Text
ELEVENLABS_API_KEY=         # Text-to-Speech
ELEVENLABS_VOICE_ID=

# Hand (Phase 4)
HAND_AGENT_TOKEN=           # Token, mit dem sich der PC-Agent am Server anmeldet
