# Kopieren nach config/.env und ausfüllen. config/.env wird NIE committet.
# Fehlt ein Schlüssel, fällt Jarvis auf die nächste Stufe zurück (bis hin zum Demo-Modus).

# ===== Gehirn =====
# Gemini – führt das Gespräch (schnell). https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modell: gemini-2.5-flash (Standard) oder z. B. gemini-3.8-flash
GEMINI_MODEL=gemini-2.5-flash
# Kurz nachdenken statt raten (Tokens). 0 = schnellste Antworten, aber ratefreudiger
GEMINI_THINKING_BUDGET=1024

# Claude – arbeitet im Hintergrund (Recherche, Texte, Analysen). https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_WORKER_MODEL=claude-sonnet-5-5
# Denktiefe des Arbeitsmodus: low | medium | high
CLAUDE_WORKER_EFFORT=high
# Selbstkontrolle: Prüfer gleicht jedes Auftragsergebnis mit den Werkzeug-Ergebnissen ab (0 = aus)
CLAUDE_WORKER_REVIEW=1

# Nur ohne Gemini: dann beantwortet Claude das Gespräch direkt mit diesem Modell
JARVIS_MODEL=claude-opus-5-5
JARVIS_EFFORT=medium

# ===== Stimme =====
# Deepgram – hört zu (Sprache zu Text). https://console.deepgram.com
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ElevenLabs – spricht. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Stimme: ID aus der ElevenLabs-Stimmenbibliothek (leer = „George“, ruhig und britisch)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
# Sprache erzwingen (verhindert englische Aussprache bei Markennamen; leer = automatisch)
ELEVENLABS_LANGUAGE=de
# Sprechtempo 0.7 – 1.2
ELEVENLABS_SPEED=1

# ===== Hände =====
# Browser auf dem Server (im Docker-Image enthalten). 0 = aus
JARVIS_BROWSER=1

# ===== Server =====
# Domain für HTTPS, z. B. jarvis.meinefirma.de (oder 1-2-3-4.sslip.io)
JARVIS_DOMAIN=
# Wer ein Profil anlegen will, braucht diesen Code. Auf einem Server IMMER setzen.
JARVIS_TEAM_CODE=
JARVIS_TZ=Europe/Berlin
PORT=3000
